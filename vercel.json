{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/utcp-manual.json", "destination": "/api" },
    { "source": "/openapi.json", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
