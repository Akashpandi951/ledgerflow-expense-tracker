# LedgerFlow Enterprise Production Environment Variables
NODE_ENV=production
PORT=4000
INSTANCE_ID=server-1

# Relational Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://ledger:secret@localhost:5432/ledgerflow

# Distributed Redis Cache & Sliding-Window Rate Limiting
REDIS_URL=redis://localhost:6379

# Cryptographic & Session Configuration
JWT_SECRET=replace_with_64_byte_random_cryptographic_secret
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_DAYS=7

# Automated Monthly Report Email Delivery (SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=reports@ledgerflow.app
SMTP_PASS=replace_with_smtp_secure_password
SMTP_FROM="LedgerFlow Automated Reports <reports@ledgerflow.app>"

# Load Balancer Cluster Node Ports
CLUSTER_PORTS=4001,4002,4003
CLUSTER_LB_PORT=4000
